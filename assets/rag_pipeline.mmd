    U --> X["Обработка<br/>и разбиение"]
    X --> E["Эмбеддинги<br/>и индекс"]
  end
  E --> DB[("PostgreSQL<br/>pgvector")]
  subgraph USE["Поддержка обучающегося"]
    direction LR
    Q(["Вопрос<br/>обучающегося"]) --> RET["Поиск<br/>по материалам"]
