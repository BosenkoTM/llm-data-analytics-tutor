flowchart TB
    D["Дисциплина"] --> T1["Тема 1"]
    D --> T2["Тема 2"]
    T1 --> L1["Лекция"]
    T1 --> P1["Практическая работа"]
    T2 --> L2["Лабораторная работа"]
    L1 --> M1["Текст и презентация"]
    P1 --> M2["Задание и критерии"]
    L2 --> M3["Notebook и данные"]
    M1 --> I[("Материалы<br/>предметного RAG")]
    M2 --> I
    M3 --> I
    class D data;
    class T1,T2 ui;
    class L1,P1,L2 agent;
    class M1,M2,M3 lms;
    class I data;

