%% Flow: индексация материалов → pgvector → retrieval → сборка контекста → генерация
flowchart LR
    MAT["Учебные материалы курса<br/>(лекции, лабораторные, программа)"]
    LOADER["EduRAG Loader<br/>(индексация — чёрный ящик)"]
    STORE[("pgvector / PostgreSQL<br/>чанки + эмбеддинги")]
    QUERY["Запрос пользователя"]
    RETR["Retrieval<br/>семантический поиск (top-k)"]
    CTX["Сборка контекста<br/>только верифицированная база курса"]
    GEN["Генерация ответа<br/>Qwen через Ollama"]
    ANS["Ответ пользователю"]

    MAT --> LOADER --> STORE
    QUERY --> RETR
    STORE --> RETR --> CTX --> GEN --> ANS

    classDef src  fill:#E6F1FB,stroke:#185FA5,color:#042C53;
    classDef box  fill:#F1EFE8,stroke:#5F5E5A,color:#2C2C2A;
    classDef gen  fill:#E1F5EE,stroke:#0F6E56,color:#04342C;
    class MAT,QUERY src;
    class LOADER,STORE,RETR,CTX box;
    class GEN,ANS gen;
